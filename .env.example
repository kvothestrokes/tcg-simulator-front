# Variables públicas. Ningún secreto de servidor (JWT secret, service role,
# DATABASE_URL) debe aparecer aquí: todo PUBLIC_* acaba en el navegador.

PUBLIC_REALTIME_URL=http://localhost:8080

# Proyecto de Supabase. La publishable key es la recomendada; ANON_KEY se
# acepta todavía si el proyecto no ha rotado las API keys.
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# PUBLIC_SUPABASE_ANON_KEY=

# Site key de Cloudflare Turnstile. Obligatorio en producción pública para
# que Anonymous Sign-Ins no se abuse. En local se puede dejar vacío.
PUBLIC_TURNSTILE_SITE_KEY=

---
import Base from '../../layouts/Base.astro';
import { RoomScreen } from '../../components/game/RoomScreen';
---

<Base title="Mesa" fullscreen>
  <!--
    La app es estática, así que el código de sala viaja en la query:
    /room/?code=ABC123. El componente lo lee en el cliente.
    /room/?test=1 abre la mesa en modo prueba, sin backend ni sesión.
  -->
  <RoomScreen client:only="react" />
</Base>

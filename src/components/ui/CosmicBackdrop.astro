---
/**
 * Fondo cósmico compartido: nebulosas, estrellas y viñeta.
 * pointer-events none; el movimiento se apaga con prefers-reduced-motion.
 */
---

<div class="cosmic-backdrop" aria-hidden="true">
  <div class="cosmic-backdrop__nebula"></div>
  <div class="cosmic-backdrop__stars cosmic-backdrop__stars--a"></div>
  <div class="cosmic-backdrop__stars cosmic-backdrop__stars--b"></div>
  <div class="cosmic-backdrop__grid"></div>
  <div class="cosmic-backdrop__vignette"></div>
</div>
